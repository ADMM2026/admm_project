        }
      },
      "geo_point":      { "type": "geo_point" },
      "capacity": {
        "properties": {
          "rooms": { "type": "integer" },
          "beds":  { "type": "integer" }
        }
      },
      "contacts": {
        "properties": {
          "phone":   { "type": "keyword", "index": false },
          "email":   { "type": "keyword", "index": false },
          "website": { "type": "keyword", "index": false }
        }
      },
      "avg_rating":     { "type": "float" },
